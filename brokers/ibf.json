{
  "_說明": "國票 itrade 網頁下單校正檔 (2026/10/07 依擷取頁面設定)。頁面底部固定下單列 + 網站自己的資料介面 (庫存 / 分戶帳餘額 / 委託回報)。",
  "order_page_match": "itrade.ibfs.com.tw/default.aspx",
  "order_page_url": "https://itrade.ibfs.com.tw/default.aspx#%E5%A7%94%E8%A8%97%E5%9B%9E%E5%A0%B1",
  "market_regular": "#btnMS_A",
  "market_odd": "#btnMS3_A",
  "pre_click": ["#btnT1_A", "#btnO1_A"],
  "code": "#StockNo_A",
  "code_ready": "#StockName_A",
  "qty": "#qty_A",
  "price": "#price_A",
  "tif_select": "#selBSFlag_A",
  "tif_value": "R",
  "sell_first_js": "$('#cbSellFirst_A').iCheck('check')",
  "sell_first_off_js": "$('#cbSellFirst_A').iCheck('uncheck')",
  "reset": "#btnReset_A",
  "buy": "#btnBC_A",
  "sell": "#btnSC_A",
  "odd_lot": "",
  "trade_type": "",
  "trade_type_options": {"現股": "", "現股當沖": ""},
  "confirm_dialog": ".jconfirm-box",
  "submit": "",
  "confirm": ".jconfirm-box .btn-confirm",
  "cancel": ".jconfirm-box .jconfirm-buttons button:not(.btn-confirm)",
  "orders_api": {
    "_說明": "委託回報：送單後用來確認這筆委託真的進到券商 (委託書號 / 狀態 / 錯誤訊息)",
    "url": "/Data/orderDataNew.ashx",
    "params": {"queryFlag": "all", "nowfunc": "", "stockNo": ""},
    "list": "orders",
    "fields": {"no": "no", "code": "stock", "bs": "BS", "ordno": "ordno", "status": "act", "error": "errMsg",
               "qty": "oVolumn", "matched": "oMatch", "price": "oPrice", "time": "otime"}
  },
  "account_api": {
    "_說明": "直接在已登入的國票分頁裡呼叫網站自己的資料介面 (不切換畫面、不開新分頁)",
    "page_match": "itrade.ibfs.com.tw/default.aspx",
    "position": {"url": "/Data/positionData.ashx",
                 "params": {"stockNo": "", "eType": "position", "positionType": "", "nowfunc": "account"},
                 "list": "position",
                 "map": {"code": "c1", "name": "c2", "type": "c3", "qty": "c9", "price": "c10",
                         "market_value": "c11", "pnl": "c12", "pnl_pct": "c14", "avg_cost": "c17"},
                 "total": "totalamt"},
    "bank": {"url": "/Data/getBankBalance.ashx", "params": {}, "list": "custBank", "cash": "acctbal", "name": "bankName"},
    "cost": {"_說明": "證券即時損益：昨日庫存 (gainloss) + 今日新增部位 (gainloss2) 的付出成本，合併算買進均價",
             "url": "/Data/gainlossData.ashx",
             "params": {"startDate": "", "endDate": "", "stockNo": "", "vType": "realized", "tradeType": "",
                        "eType": "gainloss1", "positionType": "", "nowfunc": "account"},
             "lists": ["gainloss", "gainloss2"], "code_name": "c2", "qty": "c3", "cost": "c4", "pnl": "c11",
             "total": "todayUBal"}
  },
  "account": {
    "holdings_url": "https://itrade.ibfs.com.tw/default.aspx#%E5%8D%B3%E6%99%82%E5%BA%AB%E5%AD%98",
    "holdings_table": "#sPositionFixtbl tbody",
    "refresh": "#refresh",
    "holdings_cols": {"code": 1, "name": 1, "type": 2, "qty": 8, "price": 9, "pnl": 11, "market_value": 12, "avg_cost": 14},
    "qty_unit": "股",
    "cash_url": "",
    "cash_selector": ""
  }
}
